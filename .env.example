# PostgreSQL (локально или Vercel Postgres — достаточно одной переменной)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# POSTGRES_URL=  # альтернатива, если подключили Vercel Postgres без DATABASE_URL

# Пароль HR-панели (/admin). Если пусто — вход без пароля (только для dev).
ADMIN_PASSWORD=

# Telegram (опционально; можно настроить в админке)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=